# CertPrep Coach — AI vision config
# Copy this file to ".env" (same folder) and fill in your key.
# The .env file is git-ignored, so your key is NEVER committed.

OPENAI_API_KEY=sk-your-key-here

# Optional — defaults to gpt-4o-mini (vision-capable, cheap).
# You can also use gpt-4o for higher accuracy at a bit more cost.
OPENAI_MODEL=gpt-4o-mini

# Optional — request timeout in seconds.
AI_TIMEOUT=60

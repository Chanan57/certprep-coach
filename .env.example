# CertPrep Coach — AI configuration
# Copy this file to ".env" (same folder) and fill in your values.
# .env is git-ignored, so your key is NEVER committed.

# Your OpenAI API key (required for the AI vision features).
OPENAI_API_KEY=sk-your-key-here

# Vision-capable model. gpt-4o-mini is cheap + accurate enough; gpt-4o is
# higher accuracy at a bit more cost.
OPENAI_MODEL=gpt-4o-mini

# --- Corporate network (NCS) only -----------------------------------------
# If you hit "CERTIFICATE_VERIFY_FAILED", export your corporate root CA
# (Base-64 .cer) and point to it here. See AI_SETUP.md section 2.
# OPENAI_CA_BUNDLE=C:\Dev\certprep-coach\corporate-ca.cer

# Optional — request timeout in seconds.
AI_TIMEOUT=60

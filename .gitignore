# ── Secrets & local config (NEVER commit) ─────────────────────────────
.env
*.env
.env.*
!.env.example
corporate-ca.cer
*.cer
*.pem
*.key

# ── Exam data (large / confidential — keep local only) ─────────────────
Sample Inputs/
*.pdf

# ── Local caches & runtime artefacts ───────────────────────────────────
.cache/
.progress/
certprep_img_*/
*_images/
certprep_results.csv
certprep_score_report.csv

# NOTE: ai_cache/ is intentionally NOT ignored — it is the SHARED team AI
# cache (extracted question data, no secrets). Commit it so teammates get
# AI-powered questions without needing their own API key.

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Streamlit ──────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── OS / editor ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
